@model IEnumerable<EnvíosWEB.Models.EnviosViewModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Envios</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>+ Crear Envio
    </a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Destinatario</th>
            <th>Dirección</th>
            <th>Distancia</th>
            <th>Peso</th>
            <th>Costo</th>
            <th>Estado</th>
            <th>Urgencia</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var envio in Model)
        {
            <tr>
                <td>@envio.Destinatario</td>
                <td>@envio.Direccion</td>
                <td>@envio.Distancia</td>
                <td>@envio.Peso</td>
                <td>@envio.Costo.ToString("C")</td>
                <td>
                    <span class="badge @(envio.Estado == "Entregado" ? "bg-success" : envio.Estado == "Pendiente" ? "bg-danger" : "bg-warning")">
                        @envio.Estado
                    </span>
                </td>
                <td>
                    <span class="badge @(envio.Urgencia == "Normal" ? "bg-success" : "bg-danger")">
                        @envio.Urgencia
                    </span>
                </td>
                <td>
                    <form asp-action="Update" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@envio.Id" />
                        <select name="newState" onchange="this.form.submit()" class="form-select form-select-sm">
                            <option value="">Cambiar Estado</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="EnTránsito">En Tránsito</option>
                            <option value="Entregado">Entregado</option>
                        </select>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>